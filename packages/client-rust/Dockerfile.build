FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive

# Install build dependencies
RUN apt-get update && apt-get install -y \
    curl \
    build-essential \
    pkg-config \
    libssl-dev \
    gcc-aarch64-linux-gnu \
    g++-aarch64-linux-gnu \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install Rust INSIDE the container (not on host)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain 1.91.1
ENV PATH="/root/.cargo/bin:${PATH}"

# Add aarch64 target
RUN /root/.cargo/bin/rustup target add aarch64-unknown-linux-gnu

# Configure cross-compilation linker
RUN mkdir -p /root/.cargo && \
    echo '[target.aarch64-unknown-linux-gnu]' > /root/.cargo/config.toml && \
    echo 'linker = "aarch64-linux-gnu-gcc"' >> /root/.cargo/config.toml

WORKDIR /build

CMD ["/bin/bash"]
